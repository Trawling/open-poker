# Используется docker-compose.yml. Скопируйте в .env и поправьте под себя.

# Публичный домен/адрес, с которого отдаётся фронтенд — нужен backend для CORS.
# Можно указать несколько через запятую (например, если тот же сервер
# обслуживает ещё одно зеркало/домен). Нативное Android-приложение (см.
# docs/05-android.md) разрешено всегда, без добавления сюда — у него
# фиксированный origin (http://localhost или https://localhost).
FRONTEND_ORIGIN=http://localhost:8080

# На каком порту хоста слушать фронтенд (nginx внутри контейнера всегда на 80).
PUBLIC_PORT=8080
